# Copia este archivo a `.env` (ignorado por git) y completa los valores.
# NUNCA subas secretos al repo: solo se leen por variables de entorno.

# LLM (F5): 1 activa Amazon Bedrock (Converse) vía boto3; 0 usa el camino determinista.
# Las credenciales NO van aquí: boto3 las lee del perfil de ~/.aws/credentials (AWS_PROFILE).
USE_BEDROCK=0
AWS_PROFILE=hackathon
AWS_REGION=us-east-1
# D3: Claude Sonnet 4.6 (perfil us.). Más rápido: us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Guardrail opcional (D7). Vacío = sin guardrail; la PII se redacta igual en código.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# CRM (F1): si está vacío se usa FakeCrm en memoria.
HUBSPOT_TOKEN=

# WhatsApp saliente (F7a, Meta Cloud API). 1 = envía confirmaciones; requiere token y phone id.
# Token temporal (24 h) de la consola de Meta: NUNCA en el repo.
WHATSAPP_ENABLED=0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0

# CORS: orígenes permitidos separados por coma (front local + CloudFront).
CORS_ORIGINS=http://localhost:5173

# Opcionales. Por defecto el catálogo y las franjas se leen de <raíz del repo>/data/
# (ruta resuelta desde el código, independiente del directorio de arranque).
LOG_LEVEL=INFO
# CATALOG_PATH=/ruta/absoluta/a/catalog.json
# SLOTS_PATH=/ruta/absoluta/a/slots.json
